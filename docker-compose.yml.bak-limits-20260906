version: '3.8'

services:
  web:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: porto-nopal-app
    image: porto-gw:latest
    ports:
      - "3579:3579"
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "wget --spider -q http://127.0.0.1:3579 || curl -fs http://127.0.0.1:3579 || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 15s

    deploy:
      resources:
        reservations:
          cpus: '0.5'
          memory: 512M
    environment:
      - PORT=3579
      - NODE_ENV=production
